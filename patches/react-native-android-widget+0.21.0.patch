+    private static MonthCacheDirective parseMonthCacheDirective(String label) {
+        if (label == null || !label.startsWith(MONTH_CACHE_PREFIX)) {
+            return null;
+        }
+        int separator = label.lastIndexOf(':');
+        if (separator < 0 || separator == label.length() - 1) {
+            return null;
+        }
+        try {
+            int monthOffset = Integer.parseInt(label.substring(separator + 1));
+            return new MonthCacheDirective(label.contains("_CACHE__:"), monthOffset);
+        } catch (NumberFormatException error) {
+            return null;
+        }
+    }
